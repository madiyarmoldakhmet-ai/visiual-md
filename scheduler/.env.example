# ============================================================
#  .env.example — copy to .env and fill with real values
#  (.env is gitignored; never commit real credentials)
# ============================================================

# Telegram Bot alerts (optional). InstanceRunner reads these from the
# config file's telegram.{botToken,chatId} fields, but you can also
# inject them via env when constructing configs dynamically.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instance identity when running InstanceRunner.js directly:
#   node scheduler/InstanceRunner.js --config configs/instance_1.json --id 1
INSTANCE_ID=1
